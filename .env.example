# Contoh env untuk backend (api/). Salin jadi .env untuk `vercel dev`, isi nilainya di sana.
# Di produksi, nilai yang sama diisi di Vercel > Project > Settings > Environment Variables.
# Jangan pernah commit .env.

# Pengirim email form kontak (resend.com). Key dengan izin "Sending access" saja.
RESEND_API_KEY=re_...
# Alamat penerima pesan dari form kontak
KONTAK_TUJUAN=wingmanclutch@gmail.com
# Alamat pengirim. Tanpa domain sendiri, Resend hanya mengizinkan onboarding@resend.dev
# dan hanya ke email pemilik akun Resend.
KONTAK_PENGIRIM=Wingman Clutch <onboarding@resend.dev>

# Batas kirim form kontak (Upstash Redis, gratis). Kosongkan untuk batas di memori saja (lokal).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Garam untuk hash alamat IP sebelum dipakai sebagai kunci batas kirim
GARAM_IP=ganti-dengan-string-acak

# Token GitHub fine-grained, hanya baca repo publik (opsional; tanpa token batasnya 60 permintaan per jam)
GITHUB_TOKEN=
