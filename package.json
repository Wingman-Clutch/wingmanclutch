{
  "name": "wingmanclutch",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "pnpm --filter @wingmanclutch/web dev",
    "build": "pnpm --filter @wingmanclutch/web build",
    "preview": "pnpm --filter @wingmanclutch/web preview",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @wingmanclutch/web test:e2e",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  }
}
